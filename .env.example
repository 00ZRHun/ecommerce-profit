# ---------------------------------------------------------------------------
# Profit Growth Coaching — environment configuration
#
# Copy to `.env` and edit. Every value is optional; the defaults below are the
# ones the server uses when the variable is not set. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Bind address. Use 0.0.0.0 inside a container, 127.0.0.1 for local dev.
HOST=127.0.0.1
PORT=4173

# Where leads, subscribers and analytics events are written (JSONL files).
DATA_DIR=./data

# Public origin of the site. Used for canonical URLs, sitemap and CORS checks.
SITE_URL=https://profitgrowthcoaching.com

# Comma-separated extra origins allowed to POST to the API. Leave empty when
# the site is served by this same server.
ALLOWED_ORIGINS=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Admin -----------------------------------------------------------------
# Bearer token that unlocks GET /api/leads and GET /api/stats.
# Leave empty to disable the admin API entirely (recommended on public hosts).
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Spam protection -------------------------------------------------------
# Minimum seconds a human needs to fill the form before a submission is trusted.
MIN_FORM_SECONDS=2.5

# Requests allowed per window, per IP.
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW=600
SUBSCRIBE_RATE_LIMIT=5
SUBSCRIBE_RATE_WINDOW=600
EVENT_RATE_LIMIT=90
EVENT_RATE_WINDOW=60

# Reject request bodies larger than this (bytes).
MAX_BODY_BYTES=32768

# --- Proxy / TLS -----------------------------------------------------------
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare) so
# X-Forwarded-For is trusted for rate limiting and logging.
BEHIND_PROXY=0
# Alias for BEHIND_PROXY kept for convenience.
TRUST_PROXY=0
# Emit Strict-Transport-Security. Only enable when the site is HTTPS-only.
ENABLE_HSTS=0

# --- Lead notifications (optional) ----------------------------------------
# POST each new lead to this URL (Slack incoming webhook, Zapier, Make, n8n…).
LEAD_WEBHOOK_URL=
# Optional shared secret. When set, the request is signed with
# `X-PGC-Signature: sha256=<hmac>` over the raw JSON body.
LEAD_WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=6
